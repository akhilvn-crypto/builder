{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persisted story analysis",
  "description": "test-design/state/analysis/<story-id>.json: the validated structured result of one isolated analysis plus the fingerprint it was produced from. Holds no worker transcript.",
  "type": "object",
  "required": ["version", "storyId", "runId", "inputFingerprint", "completedAt", "result"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "storyId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "pattern": "^run-[0-9]{8}-[0-9]{6}$" },
    "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completedAt": { "type": "string" },
    "result": { "$ref": "story-analysis" }
  }
}
