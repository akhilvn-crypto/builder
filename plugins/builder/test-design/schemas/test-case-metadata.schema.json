{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test case traceability metadata",
  "description": "One entry of traceability.json 'cases', keyed by test case ID. Internal metadata; never written into a test-case file.",
  "type": "object",
  "required": ["title", "storyIds"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "module": { "type": ["string", "null"] },
    "storyIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$" }
    },
    "covers": {
      "description": "Story criteria this case verifies, as '<storyId>#<criterion>' (for example 'US-001#AC-2').",
      "type": "array",
      "items": { "type": "string", "pattern": "^[^#\\s]+#[^#\\s]+$" }
    },
    "techniques": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "scenarioKey": { "type": "string" }
  }
}
